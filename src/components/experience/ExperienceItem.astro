---
import type { Experience } from "@/utils/data/experience";

interface Props {
  experience: Experience;
  showFull: boolean;
}

const { experience, showFull } = Astro.props;
---

<div
  class="flex flex-col sm:relative sm:before:absolute sm:before:top-2 sm:before:w-4 sm:before:h-4 sm:before:rounded-full sm:before:left-[-35px] sm:before:z-[1] before:bg-blue-700"
>
  <h3 class="text-xl font-semibold tracking-tight">
    {experience.company}
    {experience.client && `· Cliente: ${experience.client}`}
  </h3>
  <p class="text-xs tracking-wide text-gray-400">
    <time>{experience.startDate} - {experience.endDate}</time> · {
      experience.location
    }
  </p>

  {
    showFull && experience.careerNote && (
      <p class="mt-3 text-sm italic text-gray-600">{experience.careerNote}</p>
    )
  }

  <p class="mt-3 text-sm lg:text-base leading-relaxed">
    {experience.summary}
  </p>

  <!-- Responsabilidades -->
  {
    showFull && (
      <>
        <h4 class="mt-5 text-base font-semibold">Responsabilidades:</h4>
        <ul class="list-disc list-inside ml-3 space-y-1 text-sm sm:text-sm lg:text-md">
          {experience.responsibilities.map((responsibility) => (
            <li>{responsibility}</li>
          ))}
        </ul>
      </>
    )
  }

  <!-- Logros -->
  {
    showFull && (
      <>
        <h4 class="mt-5 text-base font-semibold">Logros:</h4>
        <ul class="list-disc list-inside ml-3 space-y-1 text-sm lg:text-md">
          {experience.achievements.map((achievement) => (
            <li>{achievement}</li>
          ))}
        </ul>
      </>
    )
  }

  <!-- Tecnologías -->
  <div class="mt-4 flex flex-wrap gap-2">
    {
      experience.technologies.map((technology) => (
        <span
          class="
          rounded-full
          border
          border-blue-200
          bg-blue-50
          px-2.5
          py-1
          text-xs
          font-medium
          text-blue-800
          "
        >
          {technology}
        </span>
      ))
    }
  </div>
</div>
