---
import ContentCard from "@/components/content/ContentCard.astro";
import type { ContentItem } from "@/utils/types/content";

interface Props {
  data: ContentItem[];
  type: "project" | "article";
  showFull?: boolean;
}

const { data, type, showFull } = Astro.props;
---

<section
  id={type === "project" ? "projects" : "articles"}
  class="px-3 sm:px-5 md:px-8 py-5"
>
  <div
    class:list={["rounded-lg p-6 md:p-8", !showFull && " bg-white shadow-lg"]}
  >
    <div class="mx-auto max-w-6xl">
      {
        !showFull && (
          <div class="mb-8 flex items-center justify-between border-b border-gray-200 pb-4">
            <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">
              {type === "project" ? "Proyectos" : "Artículos"}
            </h2>
          </div>
        )
      }
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {data.map((item) => <ContentCard data={item} type={type} />)}
      </div>

      {
        !showFull && (
          <div class="mt-8">
            <a
              href={type === "project" ? "/projects" : "/articles"}
              class="text-sm font-medium transition-colors text-gray-900 hover:text-blue-700"
            >
              {type === "project"
                ? "Ver todos los proyectos →"
                : "Ver todos los artículos →"}
            </a>
          </div>
        )
      }
    </div>
  </div>
</section>
